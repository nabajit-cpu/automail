# Set these as environment variables in Netlify (Project configuration → Environment variables).
# For local `netlify dev`, you can also put them in a .env file.

# Gmail: use an App Password, not your login password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-app-password

# Shown as "From" in recipients' inbox
FROM_NAME=Nabajit Boro
FROM_EMAIL=your.email@gmail.com
